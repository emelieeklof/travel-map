# Get a key from https://console.cloud.google.com — enable: Maps JavaScript API + Places API
VITE_GOOGLE_MAPS_API_KEY=

# Map ID — leave as DEMO_MAP_ID to use Google's demo styled vector map (required for
# AdvancedMarker). Create your own at https://console.cloud.google.com/google/maps-apis/studio/maps
# once you want custom map styling.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Supabase project — create a free project at https://supabase.com, run
# supabase/schema.sql in its SQL Editor, enable Google as an Auth provider,
# then copy these two values from Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
